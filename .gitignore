# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
.vite/

# Test and coverage output
coverage/
playwright-report/
test-results/

# npm package output
*.tgz

# Environment and local config
.env
.env.*
!.env.example
*.local

# OS files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Assistant local settings
.claude/settings.local.json

# Temporary directories
tmp/
temp/
.tmp/

# PowerCodex live view (generated, append-only) + consent gate.
# Per-project runtime lives under projects/<name>/ and stays local; the root
# .powercodex/ is ephemeral demo space. The workspace marker IS committed.
.powercodex/
Approved_rights/

# MDM browser profiles — real session cookies/tokens, never commit.
# Only the pointer (browserProfile name + profilePath) in approval.json is kept.
**/.profiles/
# PowerCodex local build/compile scratch dirs
.tmp-*
.gstack/
