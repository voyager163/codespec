{"nodes": [{"id": "openspec_changes_archive_2026_05_12_rename_to_codespec_design", "label": "Rename to CodeSpec \u2013 Design", "file_type": "document", "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_bin_name_create_codespec", "label": "Use create-codespec as the Package and Bin Name", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "create-* better signals an npm initializer and matches usage through npx, versus a plain 'codespec' bin name."}, {"id": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_rename_executable_file", "label": "Rename the Executable File to Match the Binary", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renaming to bin/create-codespec.js avoids confusing project identity in source paths and verification output, versus keeping the old filename with a new bin key."}, {"id": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_preserve_platform_names", "label": "Preserve Platform Names, Not Old Project Identity", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy initializer/repository/package fallback references should be renamed, while Power Apps Code Apps, pac code init, and microsoft/PowerAppsCodeApps references describe the app platform and upstream source, not this initializer's name, and must remain."}, {"id": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_breaking_command_rename", "label": "Treat the Command Rename as Breaking", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No legacy bin alias is kept; a compatibility alias would reduce friction for early users but would preserve the old name in package metadata and contradict the goal to rename before publishing."}, {"id": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_rename_capability_identity", "label": "Rename OpenSpec Capability Identity During Implementation", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The active spec should live under openspec/specs/codespec-initializer/, moving (not copying) the capability directory to avoid duplicate specs, while preserving archive dates and historical meaning."}], "edges": [{"source": "openspec_changes_archive_2026_05_12_rename_to_codespec_design", "target": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_bin_name_create_codespec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_rename_to_codespec_design", "target": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_rename_executable_file", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_rename_to_codespec_design", "target": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_preserve_platform_names", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_rename_to_codespec_design", "target": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_breaking_command_rename", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_rename_to_codespec_design", "target": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_rename_capability_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_rename_to_codespec_design", "target": "openspec_changes_archive_2026_05_12_rename_to_codespec_proposal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_bin_name_create_codespec", "target": "openspec_changes_archive_2026_05_12_rename_to_codespec_specs_codespec_initializer_spec_cli_identity", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-rename-to-codespec/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_rename_to_codespec_design_rename_executable_file", "target": "openspec_changes_archive_2026_05_12