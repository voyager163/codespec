{"nodes": [{"id": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design", "label": "Add Starter CI Security Workflows \u2013 Design", "file_type": "document", "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design_workflow_templates_location", "label": "Store Workflow Templates in the GitHub Overlay", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "templates/github/workflows/ aligns workflow delivery with the existing prompt/skill overlay that the initializer already copies into .github, versus splitting .github ownership across starter and overlay."}, {"id": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design_ghas_workflow_decision", "label": "Keep GHAS Checks in ghas.yml", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate GHAS-specific permissions, scheduling, and Security tab behavior are easier to reason about than combining GHAS and quality checks into one workflow."}, {"id": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design_quality_workflow_decision", "label": "Use quality.yml for Free Local and GitHub-Native Checks", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weekly drift scanning is limited to drift-sensitive jobs (Semgrep OSS, npm advisories, Scorecard) rather than rerunning every deterministic lint/format/commitlint job weekly, which would add runner cost without benefit."}, {"id": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design_coverage_gate_decision", "label": "Enforce Coverage Without Unsupported Action Inputs", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "davelosert/vitest-coverage-report-action@v2 does not define min-coverage-overall/min-coverage-changed-files inputs, so Vitest v8 provider thresholds (80% overall) plus a local changed-file coverage script enforce the gate; Vitest perFile thresholds were rejected as stricter than needed and able to block PRs over unrelated legacy files."}, {"id": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design_scorecard_permissions_decision", "label": "Isolate Scorecard Permissions", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A job-level permission override adds id-token: write and security-events: write scoped only to the Scorecard job, since publish_results: true requires id-token: write; setting publish_results: false was rejected because it does not satisfy the requested publishing behavior."}, {"id": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design_sarif_upload_decision", "label": "Upload SARIF to GitHub Code Scanning", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semgrep OSS runs without SEMGREP_APP_TOKEN and without Semgrep Cloud upload; both Semgrep and Scorecard produce SARIF uploaded via github/codeql-action/upload-sarif@v3 so results appear in the GitHub Security tab without paid services."}], "edges": [{"source": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design", "target": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design_workflow_templates_location", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design", "target": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design_ghas_workflow_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design", "target": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design_quality_workflow_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design", "target": "openspec_changes_archive_2026_05_13_add_starter_ci_security_workflows_design_coverage_gate_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-13-add-starter-ci-security-workflows/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_a