{"nodes": [{"id": "openspec_changes_archive_2026_05_12_improve_open_source_docs_design", "label": "Improve Open Source Docs \u2013 Design", "file_type": "document", "source_file": "openspec/changes/archive/2026-05-12-improve-open-source-docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_05_12_improve_open_source_docs_design_centered_readme_identity", "label": "Use a Centered README Identity Block", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-improve-open-source-docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A centered logo, tagline, value statement, and badges give new visitors context before setup details; a plain heading with badges underneath would miss the open-source identity signal."}, {"id": "openspec_changes_archive_2026_05_12_improve_open_source_docs_design_shields_badges", "label": "Use Shields.io Badges for Public Trust Signals", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-improve-open-source-docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dynamic badges for release, stars, license, and npm version are easier to maintain and avoid stale metadata compared to static badge images checked into the repo."}, {"id": "openspec_changes_archive_2026_05_12_improve_open_source_docs_design_svg_icon", "label": "Add a Small SVG Icon Under media/", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-improve-open-source-docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SVG keeps the asset small, readable, and easy to update without binary tooling, versus WebP/PNG which are more polished but less convenient for early iteration."}, {"id": "openspec_changes_archive_2026_05_12_improve_open_source_docs_design_community_files", "label": "Add Standard Community Files", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-improve-open-source-docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CODE_OF_CONDUCT.md and CONTRIBUTING.md as separate files are recognized by GitHub's repository sidebar and issue/PR surfaces, unlike contribution notes folded only into the README."}, {"id": "openspec_changes_archive_2026_05_12_improve_open_source_docs_design_openspec_swappable", "label": "Keep OpenSpec as an Explicitly Swappable Implementation Choice", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-improve-open-source-docs/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "States CodeSpec uses OpenSpec today for its low learning curve and reviewable project-local artifacts, not as permanent lock-in; presenting OpenSpec as fixed identity was rejected as conflicting with the long-term direction."}], "edges": [{"source": "openspec_changes_archive_2026_05_12_improve_open_source_docs_design", "target": "openspec_changes_archive_2026_05_12_improve_open_source_docs_design_centered_readme_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-improve-open-source-docs/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_improve_open_source_docs_design", "target": "openspec_changes_archive_2026_05_12_improve_open_source_docs_design_shields_badges", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-improve-open-source-docs/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_chan