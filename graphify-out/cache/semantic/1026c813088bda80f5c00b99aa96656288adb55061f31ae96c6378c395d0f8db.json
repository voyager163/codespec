{"nodes": [{"id": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design", "label": "Enhance Starter Template Tooling \u2013 Design", "file_type": "document", "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design_keep_react19", "label": "Keep React 19 and Update Guidance", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starter already declares React 19 and matching type packages; updating guidance is lower risk than downgrading to React 18, which would move away from the imported starter snapshot and create dependency churn."}, {"id": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design_vitest_rtl", "label": "Use Vitest with React Testing Library for Unit Smoke Coverage", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RTL + jsdom gives a realistic way to test React behavior; Vitest alone would satisfy a dependency checkbox but leave no clear component testing pattern."}, {"id": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design_playwright_devserver", "label": "Use Playwright with Automatic Dev-Server Startup", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validates the actual browser app including Vite, routing basename behavior, Tailwind rendering, and starter UI wiring; providing dependencies without a test would leave adopters to discover server/base URL setup themselves."}, {"id": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design_eslint_prettier_separate", "label": "Keep ESLint and Prettier Separate", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids formatter rules turning ordinary lint runs into formatting failures; integrating Prettier into ESLint would add noise and extra plugin dependencies."}, {"id": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design_telemetry_scaffold", "label": "Add a Thin Power Apps Telemetry Scaffold", "file_type": "concept", "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initializes an ILogger via @microsoft/power-apps/telemetry's initializeLogger without requiring an Application Insights connection string or direct trackEvent API, since those are not exposed by the inspected package types; wiring applicationinsights-web directly was rejected as conflicting with Power Apps runtime ownership."}], "edges": [{"source": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design", "target": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design_keep_react19", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design", "target": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design_vitest_rtl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design", "target": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design_playwright_devserver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design", "target": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design_eslint_prettier_separate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design", "target": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design_telemetry_scaffold", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_design", "target": "openspec_changes_archive_2026_05_12_enhance_starter_template_tooling_proposal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-05-12-enhance-starter-template-tooling/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_05_12_enhance_starter_templ