{
  "name": "powercodex-desktop",
  "productName": "PowerCodex",
  "version": "0.3.0",
  "description": "PowerCodex desktop — Chat & Agent for low-code makers, in one window.",
  "author": "PowerCodex",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "sync": "node scripts/sync-lifecycle.js",
    "start": "npm run sync && electron .",
    "test:e2e": "npm run sync && node scripts/e2e-smoke.mjs",
    "build": "node scripts/build-exe.js nsis",
    "dist": "node scripts/build-exe.js portable",
    "dist:installer": "node scripts/build-exe.js nsis",
    "dist:dir": "node scripts/build-exe.js dir",
    "dist:inplace": "npm run sync && electron-builder --win portable",
    "dist:win": "npm run sync && electron-builder --win portable",
    "dist:mac": "npm run sync && electron-builder --mac dmg",
    "pack": "npm run sync && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.61.1"
  },
  "build": {
    "appId": "com.powercodex.desktop",
    "productName": "PowerCodex",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "afterSign": "build/notarize.js",
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "PowerCodex.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "PowerCodex",
      "menuCategory": "PowerCodex",
      "artifactName": "PowerCodex-Setup.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "PowerCodex-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "PowerCodex-${version}-${arch}.dmg"
    }
  }
}
