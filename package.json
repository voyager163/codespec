{
  "name": "@elfredseow/powercodex",
  "version": "0.3.0",
  "description": "Create a Power Apps Code Apps project prepared for OpenSpec workflows. Includes a lifecycle engine, Dataverse automation, and an MCP server.",
  "license": "MIT",
  "keywords": [
    "power-apps",
    "power-platform",
    "code-apps",
    "openspec",
    "dataverse",
    "mcp",
    "scaffold",
    "cli"
  ],
  "homepage": "https://github.com/voyager163/codespec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyager163/codespec.git"
  },
  "bugs": {
    "url": "https://github.com/voyager163/codespec/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "powercodex": "bin/create-powercodex.js",
    "create-powercodex": "bin/create-powercodex.js",
    "powercodex-mcp": "bin/powercodex-mcp.mjs",
    "install-powercodex-mcp": "bin/install-plugin.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "media/",
    "templates/",
    "tools/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node scripts/verify-generated-project.js",
    "lifecycle": "node tools/lifecycle/bin/powercodex-lifecycle.js",
    "lifecycle:selftest": "node tools/lifecycle/bin/powercodex-lifecycle.js selftest",
    "cockpit": "node tools/lifecycle/bin/powercodex-lifecycle.js cockpit",
    "import": "node tools/lifecycle/bin/powercodex-lifecycle.js import",
    "mcp": "node bin/powercodex-mcp.mjs",
    "test": "node --test src/mcp/__tests__/*.test.mjs",
    "test:mcp": "node --test src/mcp/__tests__/*.test.mjs",
    "test:e2e": "node --test src/mcp/__tests__/real-mode.e2e.mjs",
    "test:lifecycle": "node --test tools/lifecycle/__tests__/*.test.js",
    "install-powercodex-mcp": "node bin/install-plugin.mjs",
    "dataverse:init": "node tools/lifecycle/bin/powercodex-lifecycle.js dataverse init",
    "dataverse:apply": "node tools/lifecycle/bin/powercodex-lifecycle.js dataverse apply",
    "code-init": "node tools/lifecycle/bin/powercodex-lifecycle.js code-init"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}